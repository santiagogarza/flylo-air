# Server-only. Set these in the Vercel project settings (or .env.local for local dev). Never prefix with NEXT_PUBLIC_.

# Mints short-lived xAI realtime voice sessions for /support.
XAI_API_KEY=

# Support ticket webhook. The key is sent in the header named by SUPPORT_WEBHOOK_HEADER.
# Scenarios that omit a webhook, and Lakeline when its own vars are unset, use these.
SUPPORT_WEBHOOK_URL=
SUPPORT_WEBHOOK_HEADER=
SUPPORT_WEBHOOK_KEY=
# On the Vercel preview: SUPPORT_WEBHOOK_HEADER=Authorization and LAKELINE_WEBHOOK_KEY already
# starts with "Bearer ". The key is sent exactly as stored, so nothing adds a second prefix.

# Lakeline hardship intake. Optional. When unset, tickets fall back to SUPPORT_WEBHOOK_*.
# The header name is SUPPORT_WEBHOOK_HEADER. Do not add a second header variable.
LAKELINE_WEBHOOK_URL=
LAKELINE_WEBHOOK_KEY=

# Protects POST /api/reset (sent as the x-demo-reset-key header).
# Also authorizes POST /api/cases unless CASES_INGEST_KEY is set.
DEMO_RESET_KEY=

# Optional. When set, POST /api/cases requires this key instead of DEMO_RESET_KEY.
# Send it as Authorization: Bearer <key>, or as the x-demo-reset-key header.
CASES_INGEST_KEY=

# Durable demo store for tickets, the id counter, and review cases. Optional.
# Vercel serverless instances do not share memory, so set one of these on Preview.
# 1. Vercel Blob (private store). Preferred.
BLOB_READ_WRITE_TOKEN=
# 2. Upstash / Vercel KV. Used when there is no Blob token.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# With neither, state lives in this server's memory only.

# Optional: extra origins allowed to call the API, comma separated (same-origin and localhost are always allowed).
ALLOWED_ORIGINS=
