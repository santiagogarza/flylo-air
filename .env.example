# Server-only. Set these in the Vercel project settings (or .env.local for local dev). Never prefix with NEXT_PUBLIC_.

# Mints short-lived xAI realtime voice sessions for /support.
XAI_API_KEY=

# Support ticket webhook. The key is sent in the header named by SUPPORT_WEBHOOK_HEADER.
SUPPORT_WEBHOOK_URL=
SUPPORT_WEBHOOK_HEADER=
SUPPORT_WEBHOOK_KEY=

# Protects POST /api/reset (sent as the x-demo-reset-key header).
DEMO_RESET_KEY=

# Optional: extra origins allowed to call the API, comma separated (same-origin and localhost are always allowed).
ALLOWED_ORIGINS=
